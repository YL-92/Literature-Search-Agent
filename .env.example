# 应用
LITSEARCH_APP_NAME=litsearch-agent
LITSEARCH_LOG_LEVEL=INFO

# 与 OpenAI 兼容的 LLM 端点（本地 CLI 帮助时凭证可选）
LITSEARCH_OPENAI_API_KEY=
LITSEARCH_OPENAI_BASE_URL=https://api.deepseek.com
LITSEARCH_OPENAI_MODEL=deepseek-chat

# 可选的外部服务配置
LITSEARCH_SEMANTIC_SCHOLAR_API_KEY=
LITSEARCH_SEMANTIC_SCHOLAR_API_URL=
LITSEARCH_ARXIV_API_URL=https://export.arxiv.org/api/query
LITSEARCH_REQUEST_TIMEOUT=20
LITSEARCH_REQUEST_MAX_RETRIES=3
LITSEARCH_CACHE_DIR=.cache/litsearch

# 主要学术来源：OpenAlex 是免费的，无需 API 密钥。
LITSEARCH_SCHOLAR_PROVIDER=openalex
LITSEARCH_OPENALEX_BASE_URL=https://api.openalex.org
LITSEARCH_OPENALEX_MAILTO=your@email.com
LITSEARCH_OPENALEX_RPS=8

# 可选备用；默认情况下禁用。
LITSEARCH_SEMANTIC_SCHOLAR_ENABLED=false